current_table <- readxl::read_xlsx(glue::glue('Summary_output_all_datasets{folder_suffix}/Performance metrics/Dataset summary.xlsx'))
#Delete entries from previous runs if present
current_table <- current_table %>% filter(`Dataset name` != paste0(ds_name,celltype_suffix))
current_table[nrow(current_table)+1,
c('Dataset name','RMSE','Mean pearson','Mean spearman','Mean per prot pearson', 'Mean per prot spearman')] <-  cbind(
paste0(ds_name,celltype_suffix),
round(performance_evaluation$rmse,5),
round(performance_evaluation$mean_pearson,5),
round(performance_evaluation$mean_spearman,5),
round(mean(performance_evaluation$pearson,na.rm = TRUE),5),
round(mean(performance_evaluation$spearman,na.rm = TRUE),5)
)
WriteXLS::WriteXLS(current_table,glue::glue('Summary_output_all_datasets{folder_suffix}/Performance metrics/Dataset summary.xlsx'),row.names = FALSE)
# Save prediction evaluation plots ----------------------------------------
source('Plot_comparison.R')
# Same as within scLinear --> can't do CLR of 0 so set to 1
adt_test[adt_test == 0] <- 0.99
# reference <- Matrix::Matrix((t(compositions::clr(t(as.matrix(adt_test))))),sparse = TRUE)
if(norm_method == 'log'){
reference <- log(adt_test)
}else if(norm_method == 'CLR'){
reference <- Matrix::Matrix((t(compositions::clr(t(as.matrix(test))))),sparse = TRUE)
}
cell_meta <- InputDS@meta.data
cell_annot <- cell_meta[colnames(reference),'cell_type']
if(!(dataset_name %in% dir(glue::glue('Summary_output_all_datasets{folder_suffix}/Prediction_evaluation_plots/')))){
dir.create(glue::glue('Summary_output_all_datasets{folder_suffix}/Prediction_evaluation_plots/{dataset_name}'))
}
for(i in 1:ncol(test_prediction)){
plot_comparison((reference)[i,],test_prediction[,i],groupings = cell_annot) + xlab(glue::glue('True {norm_method}(ADT)')) + ylab(glue::glue('Predicted {norm_method}(ADT)')) +
ggtitle(colnames(test_prediction)[i], subtitle = paste0(' R (pearson) = ',
round(performance_evaluation$pearson[colnames(test_prediction)[i]],4)))
ggsave(glue::glue('Summary_output_all_datasets{folder_suffix}/Prediction_evaluation_plots/{dataset_name}/{colnames(test_prediction)[i]}{celltype_suffix}_true_vs_predicted.png'),
width = 10,height = 10)
}
# Save feature importance -------------------------------------------------
# Feature importance calc takes very long --> take a subset of the subset that is the test data
fi <- feature_importance(trained_model,(gex_test)[,sample(colnames(gex_test),min(5000,ncol(gex_test)),replace = FALSE)],n_cores = 1,normalize_gex = FALSE)
WriteXLS::WriteXLS(data.frame(fi),glue::glue('Summary_output_all_datasets{folder_suffix}/Feature_importance_matrices/{dataset_name}{celltype_suffix}_feature_importances.xlsx'),
row.names = TRUE)
#Previously carried over inputdata to next loop iteration
}
if(mode == 'all'){
train_one_model(Input_Seurat,'',dataset_name,norm_method)
}else{
for(celltype in all_celltypes){
cell_type_specific_final_output <- glue::glue(
'Summary_output_all_datasets_per_celltype/Feature_importance_matrices/{dataset_name}_{celltype}_feature_importances.xlsx'
)
if(file.exists(cell_type_specific_final_output)){next}
train_one_model(Input_Seurat,celltype,dataset_name,norm_method)
}
}
# Mainly to remove Input from current dataset so it doesn't get mixed in with next
rm(list = ls()[!(ls() %in% c('dataset_infos','dataset_index','mode','norm_method') )])
}
# Cross dataset predictions -----------------------------------------------
