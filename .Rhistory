plot_function <- function(prot_val_true, prot_val_predicted){
plot_df <- data.frame(cbind(prot_val_true,
prot_val_predicted))
colnames(plot_df) <- c('True CD3','Predicted CD3')
p <- ggplot(plot_df,aes(x = `True CD3`, y = `Predicted CD3`)) + geom_point() +
theme(axis.title = element_text(size = 10)) +
geom_abline(intercept = 0, slope = 1, color = 'red')
return(p)
}
