ggdraw() + draw_label("Trained on", fontface = "bold", size = 14),
top_labels,
center_with_title,
ncol = 1,
rel_heights = c(0.08, 0.08, 1)
)
ggsave('Cross_dataset_stability.pdf',final_plot, width = 12, height = 12, units = 'cm')
